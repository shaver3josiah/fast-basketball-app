{
  "expo": {
    "name": "Fast Basketball",
    "slug": "fast-basketball-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fastbasketball",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0C",
    "primaryColor": "#E60C20",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fastbasketball.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Shot Form watches your shooting form through the camera. Nothing is recorded and no video leaves your phone."
      }
    },
    "android": {
      "package": "com.fastbasketball.app",
      "versionCode": 1,
      "permissions": ["android.permission.CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0A0A0C",
          "imageWidth": 180
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "The Dribble Counter listens for the bounce of the ball. No audio is recorded and no sound leaves your phone.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#E60C20",
          "mode": "production"
        }
      ],
      "./plugins/with-play-manifest",
      "expo-asset"
    ]
  }
}
